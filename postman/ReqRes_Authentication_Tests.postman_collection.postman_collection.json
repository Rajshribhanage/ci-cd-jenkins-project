  },
  "item": [
    {
      "name": "Test Case 1: Valid Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "let responseJson = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains token\", function () {\r",
              "    pm.expect(responseJson).to.have.property(\"token\");\r",
              "});\r",
              "\r",
              "pm.test(\"Token is not empty\", function () {\r",
              "    pm.expect(responseJson.token).to.not.be.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "x-api-key",
            "value": "free_user_3DfSpf4FGQatSR5XI7GPkoEWXbl",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"eve.holt@reqres.in\",\r\n  \"password\": \"cityslicka\"\r\n}"
        },
        "url": {
          "raw": "https://reqres.in/api/login",
          "protocol": "https",
          "host": [
            "reqres",
            "in"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "response": []
    },
    {
