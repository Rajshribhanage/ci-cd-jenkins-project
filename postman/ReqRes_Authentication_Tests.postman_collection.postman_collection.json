              "});\r",
              "\r",
              "const responseJson = pm.response.json();\r",
              "\r",
              "pm.test(\"Error message is invalid credentials\", function () {\r",
              "    pm.expect(responseJson.error).to.eql(\"user not found\");\r",
              "});"
